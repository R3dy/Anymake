{
  "name": "anymake",
  "version": "1.1.0",
  "type": "module",
  "main": ".opencode/plugins/anymake.js",
  "description": "Anymake — Agentic build system. Takes any software idea (SaaS, CLI, library, API, internal tool, static site, or hobby project) from raw concept to a finished, shipped result.",
  "scripts": {
    "verify": "node .opencode/verify-plugin.mjs",
    "validate-board": "node .opencode/validate-board-state.mjs",
    "test": "node .opencode/verify-plugin.mjs",
    "eval": "node evals/run.mjs",
    "eval:probe": "node evals/run.mjs --probe",
    "eval:selftest": "node evals/selftest.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "skill",
    "saas",
    "cli",
    "library",
    "anymake",
    "builder",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/R3dy/Anymake.git"
  },
  "license": "MIT",
  "files": [
    ".opencode/",
    "AGENTS/",
    "AGENTS.md",
    "PHASE_GUIDES/",
    "PROJECT_TYPES/",
    "TEMPLATES/",
    "skills/",
    "dashboard/",
    "llms.txt",
    "README.md",
    "CHANGELOG.md"
  ]
}
